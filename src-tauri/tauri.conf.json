{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freebie-radar",
  "version": "1.0.0",
  "identifier": "com.zichuanlan.freebie-radar",
  "build": {
    "beforeBuildCommand": "npm run build && npm run build:server",
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web"
  },
  "app": {
    "windows": [],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/128x128.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist/web": "dist/web",
      "../dist/server.mjs": "src/server/server.mjs"
    },
    "externalBin": ["binaries/node"],
    "linux": {
      "deb": {
        "depends": ["curl", "libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
